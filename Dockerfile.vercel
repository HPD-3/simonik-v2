# syntax=docker/dockerfile:1

##
# SIMONIK V2 — production image for Vercel Container deployment.
# Stack: Laravel 13 (PHP 8.4) + Inertia + React 19 + Vite + MySQL.
##

# ---------------------------------------------------------------------------
# Stage 1 — PHP dependencies
# ---------------------------------------------------------------------------
FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-scripts \
    --prefer-dist \
    --optimize-autoloader \
    --ignore-platform-reqs

# ---------------------------------------------------------------------------
# Stage 2 — Frontend assets (Vite build)
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS assets
WORKDIR /app

# PHP 8.4 CLI is required so the Wayfinder Vite plugin can run `php artisan`.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates apt-transport-https lsb-release gnupg curl unzip \
    && curl -sSL https://packages.sury.org/php/apt.gpg -o /etc/apt/trusted.gpg.d/php.gpg \
    && echo "deb https://packages.sury.org/php/ $(lsb_release -sc) main" > /etc/apt/sources.list.d/php.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        php8.4-cli php8.4-mbstring php8.4-xml php8.4-tokenizer php8.4-curl php8.4-sqlite3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=vendor /app/vendor ./vendor
COPY . .

# Wayfinder boots the Laravel app during `vite build`, which needs an APP_KEY.
RUN cp .env.example .env && php artisan key:generate --force

RUN npm install --no-audit --no-fund
RUN npm run build

# ---------------------------------------------------------------------------
# Stage 3 — Runtime (nginx + php-fpm)
# ---------------------------------------------------------------------------
FROM serversideup/php:8.4-fpm-nginx AS runtime

USER root

# Extra PHP extensions used by the app (MySQL, GD for image handling).
RUN install-php-extensions pdo_mysql gd bcmath

WORKDIR /var/www/html

# Application source + built dependencies.
COPY --chown=www-data:www-data . .
COPY --chown=www-data:www-data --from=vendor /app/vendor ./vendor
COPY --chown=www-data:www-data --from=assets /app/public/build ./public/build

# Copy wrapper entrypoint to bind dynamic $PORT
COPY --chmod=755 docker/entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

# Copy startup hook to run migrations and all seeders
COPY --chmod=755 docker/entrypoint-seed.sh /etc/entrypoint.d/99-seed.sh
RUN sed -i 's/\r$//' /etc/entrypoint.d/99-seed.sh && chmod +x /etc/entrypoint.d/99-seed.sh

ENV PORT=80 \
    NGINX_HTTP_PORT=80 \
    PHP_OPCACHE_ENABLE=1 \
    AUTORUN_ENABLED=true \
    AUTORUN_LARAVEL_STORAGE_LINK=true \
    AUTORUN_LARAVEL_MIGRATION=true \
    AUTORUN_LARAVEL_SEED=true \
    AUTORUN_LARAVEL_CONFIG_CACHE=true \
    AUTORUN_LARAVEL_ROUTE_CACHE=true \
    AUTORUN_LARAVEL_VIEW_CACHE=true \
    AUTORUN_LARAVEL_EVENT_CACHE=true

USER www-data

EXPOSE 80 8080 3000

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/init"]
